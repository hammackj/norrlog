# Rust build output. 2 GB and fully reproducible from Cargo.lock.
/target/

# Runtime state lives in ~/.config/norrlog (and ~/.local/share/norrlog), and
# the app's settings in ~/.config/eqlparser-gui —
# buff marks, seeded task definitions, the Sky quest catalogue, window
# geometry. Never inside the repo, but ignore stray copies just in case.
*.local.json
/config.json

# Game logs. Enormous, and they contain the player's chat.
*.txt.log
eqlog_*.txt

# Byte-compiled helpers in tools/.
__pycache__/

# Editor and OS noise.
.vscode/
.idea/
*.swp
*~
.DS_Store
