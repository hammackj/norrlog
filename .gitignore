# Rust build output. 2 GB and fully reproducible from Cargo.lock.
/target/

# Runtime state lives in ~/.config/norrlog (and ~/.local/share/norrlog), and
# the app's settings in ~/.config/eqlparser-gui —
# buff marks, seeded task definitions, the Sky quest catalogue, window
# geometry. Never inside the repo, but ignore stray copies just in case.
*.local.json
/config.json

# Game logs. Enormous, and they contain the player's chat.
*.txt.log
eqlog_*.txt

# Byte-compiled helpers in tools/.
__pycache__/

# Raw pages kept by tools/import-eqtraders.py. This is an archive, not build
# output — keep it, back it up, but it does not belong in the repo. The
# recipes derived from it are committed instead.
.eqtraders-cache/

# Progress output from a crawl run. Regenerated every run, and only ever
# interesting while one is in flight.
tools/crawl.log

# Editor and OS noise.
.vscode/
.idea/
*.swp
*~
.DS_Store
